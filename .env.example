# Core Rental — environment (see README § AI Workspace Designer)
# Provider selection: AI_PROVIDER=openai-compatible|openai|anthropic
# (inferred when unset: AI_BASE_URL → compatible · ANTHROPIC_API_KEY → anthropic · else → openai)

# 1) openai-compatible — LM Studio locally (free/offline) or OpenRouter (config-only):
AI_BASE_URL=http://localhost:8080/v1
AI_MODEL=Qwen3-Coder-30B-A3B-Instruct
# AI_API_KEY=sk-or-...     # OpenRouter key (LM Studio accepts any non-empty value)

# 2) anthropic — native Anthropic API:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-0

# 3) openai — native OpenAI API:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4.1-mini
